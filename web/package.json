{
  "name": "age-estimator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:static": "npm run stage && vite --mode static",
    "stage": "node scripts/stage-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "build:static": "npm run stage && tsc --noEmit && vite build --mode static",
    "preview": "vite preview",
    "preview:static": "vite preview --mode static",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  }
}
